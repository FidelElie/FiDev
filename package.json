{
	"name": "fi",
	"version": "1.0.0",
	"private": true,
	"author": "Fidel Pierre Elie",
	"description": "Monorepo for the personal website and all the procrastination that comes with it.",
	"license": "MIT",
	"packageManager": "pnpm@9.11.0",
	"engines": {
		"node": ">=20"
	},
	"scripts": {
		"dev": "turbo run dev",
		"check": "turbo run check",
		"lint": "turbo run lint",
		"format": "dprint fmt",
		"format:check": "dprint check",
		"@home": "pnpm --filter @fi/home",
		"@server": "pnpm --filter @fi/server",
		"@content": "pnpm --filter @fi/content",
		"@scripts": "pnpm --filter @fi/scripts",
		"node": "tsx",
		"prepare": "husky",
		"lint-staged": "lint-staged"
	},
	"devDependencies": {
		"dprint": "^0.49.0",
		"husky": "^9.1.7",
		"lint-staged": "^15.5.0",
		"oxlint": "^0.15.15",
		"tsx": "^4.19.1",
		"turbo": "^2.2.3",
		"typescript": "^5.7.2",
		"vitest": "3.0.8"
	},
	"lint-staged": {
		"**/*": [
			"pnpm format --staged"
		]
	}
}
